# ------------------------------------------------------------------------------
# RiskIntel Public Website — Frontend Environment Template
# ------------------------------------------------------------------------------
# Copy to `.env.local` (git-ignored) and fill in values for your environment.
#
# SECURITY: everything prefixed with VITE_ is inlined into the JavaScript bundle
# and is therefore PUBLIC. Never put DATABASE_URL, JWT_SECRET_KEY, SECRET_KEY,
# SMTP_PASSWORD, API secrets or private keys in this file or in any .env file
# under this directory. Backend secrets live in public-website/backend/.env and
# must stay there.
# ------------------------------------------------------------------------------

# Base URL of the FastAPI backend, WITHOUT a trailing slash and WITHOUT /api/v1.
# The API client appends the versioned path itself.
#   local backend  -> http://localhost:8080
#   same-origin    -> leave empty to use a reverse-proxy on the current origin
VITE_API_BASE_URL=

# Public origin of this website. Used for canonical URLs and Open Graph tags.
VITE_SITE_URL=

# Request timeout for API calls, in milliseconds.
VITE_API_TIMEOUT_MS=

# Contact address shown on public pages (public information only).
VITE_SUPPORT_EMAIL=

# Set to "true" only in non-production environments to allow indexing controls
# and verbose client-side error surfaces to be exercised.
VITE_ENABLE_DEV_DIAGNOSTICS=
