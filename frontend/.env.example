# REACT_APP_API_URL is intentionally unset so API calls use window.location.origin
# This makes the frontend work from any host (127.0.0.1, localhost, IP address)

# ============================= Development =================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/wss/dashboard
# ====================================================================================


# =================================== Production ======================================
# REACT_APP_API_URL=https://127.0.0.1
# REACT_APP_WS_URL=wss://127.0.0.1/wss/dashboard

#-------------- HTTP ---------------------
# Replace YOUR_SERVER_IP with actual IP (e.g., 192.168.1.100)
# REACT_APP_API_URL=http://YOUR_SERVER_IP:8000
# REACT_APP_WS_URL=ws://YOUR_SERVER_IP:8000/wss/dashboard

# -------------- HTTPS -------------------
# Replace YOUR_DOMAIN with actual domain (e.g., example.com)
# REACT_APP_API_URL=https://api.YOUR_DOMAIN
# REACT_APP_WS_URL=wss://api.YOUR_DOMAIN/wss/dashboard


# ====================================================================================
